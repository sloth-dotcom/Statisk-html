# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Neon/Supabase connection string, eller lokal Postgres.
DATABASE_URL=postgres://udbudsradar:udbudsradar@127.0.0.1:5432/udbudsradar

# ---------------------------------------------------------------------------
# udbud.dk API
# ---------------------------------------------------------------------------
# UVERIFICERET: base-URL og autentifikation er ikke bekræftet mod et rigtigt
# kald — se docs/api-noter.md og docs/aabne-spoergsmaal.md.
UDBUD_API_BASE_URL=
UDBUD_API_KEY=
# Hvilken header nøglen sendes i. Skal verificeres mod openapi.yml.
UDBUD_API_KEY_HEADER=X-API-Key
# Maks samtidige kald mod API'et. Hold den lav indtil rate limits er kendt.
UDBUD_MAX_CONCURRENCY=2
UDBUD_PAGE_SIZE=50
UDBUD_MAX_PAGES=200
# Overlap tilbage i tid ved hver kørsel. Overlap er gratis, tabte udbud er ikke.
INGEST_OVERLAP_HOURS=24
# Hvor langt tilbage den allerførste kørsel henter.
INGEST_INITIAL_LOOKBACK_DAYS=30

# ---------------------------------------------------------------------------
# AI-scoring
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Hvor grundigt modellen tænker pr. udbud: low | medium | high | xhigh | max.
ANTHROPIC_EFFORT=medium
# Loft pr. scoringskørsel, så en fejlkonfiguration ikke koster en månedsløn.
SCORING_MAX_NOTICES_PER_RUN=50
SCORING_BATCH_SIZE=5

# ---------------------------------------------------------------------------
# Cron og notifikationer
# ---------------------------------------------------------------------------
# Beskytter /api/cron/* mod kald udefra. Sendes som "Authorization: Bearer <secret>"
# eller "x-cron-secret: <secret>".
CRON_SECRET=
RESEND_API_KEY=
DIGEST_FROM=Udbudsradar <udbudsradar@example.dk>
DIGEST_RECIPIENTS=
DIGEST_MAX_ITEMS=15
SLACK_WEBHOOK_URL=

# Bruges i digest-mails til at linke til vores egen detaljeside.
APP_BASE_URL=http://localhost:3000
